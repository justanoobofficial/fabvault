rules_version = '2';

// Launch configuration for The Fab Vault.
//
// Reads on `products` are public (the storefront needs them). Writes are open
// because the admin console authenticates with a client side passphrase, which
// is enough to keep the route hidden but is NOT a security boundary.
//
// Before taking real money at scale, switch the console to Firebase Auth and
// replace the write rules with: allow write: if request.auth.token.admin == true;
service cloud.firestore {
  match /databases/{database}/documents {

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

  }
}
