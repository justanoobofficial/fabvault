rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVaultAdmin() {
      return request.auth != null
        && request.auth.token.email == "support.fabuyodevs@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isVaultAdmin();
    }

    match /orders/{orderId} {
      allow read: if isVaultAdmin();
      // Public checkout may only create a pending WhatsApp enquiry.
      // Paid orders are written by the server after Paystack verification.
      allow create: if request.resource.data.channel == "whatsapp"
        && request.resource.data.status == "pending"
        && request.resource.data.reference is string
        && request.resource.data.reference.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.customer is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 20
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal > 0
        && request.resource.data.currency == "NGN";
      allow update, delete: if isVaultAdmin();
    }
  }
}
